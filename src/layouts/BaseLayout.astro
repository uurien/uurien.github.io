---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Inner pages show just the name and social links, not the full intro. */
  compactHeader?: boolean;
}

const {
  title = 'Ugaitz Urien',
  description = 'Software engineer. Things I make outside work: software, games, 3D prints, hardware and other experiments.',
  compactHeader = false,
} = Astro.props;

const pageTitle = title === 'Ugaitz Urien' ? title : `${title} · Ugaitz Urien`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header compact={compactHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
