---
import { site } from '../config/site';

interface Props {
  // Compact mode is used on inner pages (/things, a Thing page) — just the
  // name and social links, without the bio/location lines.
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <div class="site-header__intro">
      <h1 class="site-header__name">
        <a href="/">{site.name.toUpperCase()}</a>
      </h1>
      {
        !compact && (
          <div class="site-header__bio">
            {site.tagline.map((line) => (
              <p>{line}</p>
            ))}
            <p class="site-header__location">
              <svg
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {site.location}
            </p>
          </div>
        )
      }
    </div>
    <nav class="site-header__social" aria-label="Social links">
      <a href={site.social.github} target="_blank" rel="me noopener noreferrer">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.84-1.35-3.84-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.67 5.33-5.21 5.62.41.36.77 1.06.77 2.14 0 1.54-.01 2.79-.01 3.17 0 .3.2.66.79.55 4.52-1.51 7.77-5.77 7.77-10.78C23.02 5.24 18.27.5 12 .5Z"
          />
        </svg>
        <span>GitHub</span>
      </a>
      <a href={site.social.bluesky} target="_blank" rel="me noopener noreferrer">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 8.6C10.6 5.9 7 3.7 4.7 3.3c-.8-.1-1.4.5-1.4 1.3v11.2c0 .8.6 1.4 1.4 1.5 3.3.5 6.4 2.3 7.3 4.6.9-2.3 4-4.1 7.3-4.6.8-.1 1.4-.7 1.4-1.5V4.6c0-.8-.6-1.4-1.4-1.3C17 3.7 13.4 5.9 12 8.6Z"
          />
        </svg>
        <span>Bluesky</span>
      </a>
      <a href={site.social.linkedin} target="_blank" rel="me noopener noreferrer">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M4.98 3.5C3.33 3.5 2 4.83 2 6.48c0 1.65 1.33 3 2.98 3s2.98-1.35 2.98-3c0-1.65-1.33-2.98-2.98-2.98ZM2.4 21.5h5.16V8.98H2.4V21.5ZM9.98 8.98h4.95v1.71h.07c.69-1.26 2.37-2.6 4.88-2.6 5.22 0 6.18 3.36 6.18 7.73v7.68h-5.16v-6.8c0-1.62-.03-3.7-2.29-3.7-2.29 0-2.64 1.75-2.64 3.58v6.92H9.98V8.98Z"
          />
        </svg>
        <span>LinkedIn</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 2.25rem 1.5rem;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__name {
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .site-header__name a:hover,
  .site-header__name a:focus-visible {
    color: var(--text-dim);
  }

  .site-header__bio {
    margin-top: 0.85rem;
    max-width: 46ch;
    color: var(--text);
  }

  .site-header__bio p {
    margin-top: 0.3rem;
  }

  .site-header__bio p:first-child {
    margin-top: 0;
  }

  .site-header__location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .site-header__social {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .site-header__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .site-header__social a:hover,
  .site-header__social a:focus-visible {
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .site-header__social span {
      display: none;
    }
  }
</style>
