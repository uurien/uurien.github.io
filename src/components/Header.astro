---
import { site } from '../config/site';

interface Props {
  // Compact mode is used on inner pages (/things, a Thing page) — just the
  // name and social links, without the bio/location lines.
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <div class="site-header__intro">
      <h1 class="site-header__name">
        <a href="/">{site.name.toUpperCase()}</a>
      </h1>
      {
        !compact && (
          <div class="site-header__bio">
            {site.tagline.map((line) => (
              <p>{line}</p>
            ))}
            <p class="site-header__location">
              <svg
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {site.location}
            </p>
          </div>
        )
      }
    </div>
    <nav class="site-header__social" aria-label="Social links">
      <a href={site.social.github} target="_blank" rel="me noopener noreferrer">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M12 .5C5.73.5.98 5.24.98 11.52c0 5.02 3.26 9.28 7.78 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.17.69-3.84-1.35-3.84-1.35-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.25 3.33.95.1-.74.4-1.25.72-1.54-2.53-.29-5.19-1.27-5.19-5.63 0-1.24.44-2.26 1.17-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.17 1.82 1.17 3.06 0 4.37-2.67 5.33-5.21 5.62.41.36.77 1.06.77 2.14 0 1.54-.01 2.79-.01 3.17 0 .3.2.66.79.55 4.52-1.51 7.77-5.77 7.77-10.78C23.02 5.24 18.27.5 12 .5Z"
          />
        </svg>
        <span>GitHub</span>
      </a>
      <a href={site.social.bluesky} target="_blank" rel="me noopener noreferrer">
        {/* Official butterfly from bsky.social/about/support/icons */}
        <svg aria-hidden="true" width="20" height="18" viewBox="0 0 568 501" fill="currentColor">
          <path
            d="M123.121 33.6637C188.241 82.5526 258.281 181.681 284 234.873C309.719 181.681 379.759 82.5526 444.879 33.6637C491.866 -1.61183 568 -28.9064 568 57.9464C568 75.2916 558.055 203.659 552.222 224.501C531.947 296.954 458.067 315.434 392.347 304.249C507.222 323.8 536.444 388.56 473.333 453.32C353.473 576.312 301.061 422.461 287.631 383.039C285.169 375.812 284.017 372.431 284 375.306C283.983 372.431 282.831 375.812 280.369 383.039C266.939 422.461 214.527 576.312 94.6667 453.32C31.5556 388.56 60.7778 323.8 175.653 304.249C109.933 315.434 36.0535 296.954 15.7778 224.501C9.94525 203.659 0 75.2916 0 57.9464C0 -28.9064 76.1345 -1.61183 123.121 33.6637Z"
          />
        </svg>
        <span>Bluesky</span>
      </a>
      <a href={site.social.linkedin} target="_blank" rel="me noopener noreferrer">
        {/* Official [in] bug from brand.linkedin.com/downloads, vectorised from their PNG */}
        <svg
          aria-hidden="true"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          fill-rule="evenodd"
        >
          <path
            d="M1.403 23.934C0.777 23.8 0.237 23.285 0.077 22.671C0.007 22.404 0.007 1.596 0.077 1.329C0.228 0.747 0.695 0.277 1.309 0.087C1.595-0.001 22.405-0.001 22.691 0.087C23.307 0.277 23.771 0.743 23.922 1.325C23.994 1.6 23.994 22.4 23.922 22.675C23.76 23.3 23.224 23.799 22.568 23.938C22.244 24.007 1.724 24.003 1.403 23.934ZM7.123 14.723L7.123 9.015L5.346 9.007L3.569 9L3.569 14.702C3.569 17.839 3.579 20.414 3.59 20.426C3.601 20.437 4.401 20.443 5.367 20.439L7.123 20.431L7.123 14.723ZM12.901 17.269C12.911 15.067 12.926 14.017 12.951 13.846C13.151 12.481 13.787 11.863 15 11.854C16.075 11.847 16.616 12.343 16.82 13.523C16.864 13.778 16.872 14.235 16.883 17.131L16.896 20.446L18.663 20.446L20.431 20.446L20.431 16.958C20.431 13.488 20.42 13.047 20.32 12.323C19.98 9.879 18.699 8.747 16.262 8.74C14.795 8.736 13.554 9.342 12.938 10.363C12.871 10.475 12.805 10.568 12.792 10.568C12.78 10.569 12.769 10.216 12.769 9.785L12.769 9L11.062 9L9.354 9L9.354 14.703C9.354 17.839 9.363 20.414 9.374 20.426C9.386 20.437 10.181 20.446 11.141 20.446L12.888 20.446L12.901 17.269ZM5.858 7.37C7.383 6.98 7.92 5.078 6.821 3.96C5.72 2.839 3.886 3.272 3.394 4.769C2.901 6.265 4.321 7.763 5.858 7.37Z"
          />
        </svg>
        <span>LinkedIn</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 2.25rem 1.5rem;
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__name {
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .site-header__name a:hover,
  .site-header__name a:focus-visible {
    color: var(--text-dim);
  }

  .site-header__bio {
    margin-top: 0.85rem;
    max-width: 46ch;
    color: var(--text);
  }

  .site-header__bio p {
    margin-top: 0.3rem;
  }

  .site-header__bio p:first-child {
    margin-top: 0;
  }

  .site-header__location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.75rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .site-header__social {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .site-header__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: var(--text);
  }

  .site-header__social a:hover,
  .site-header__social a:focus-visible {
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .site-header__social span {
      display: none;
    }
  }
</style>
