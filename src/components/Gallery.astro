---
import { Image } from 'astro:assets';

// ImageMetadata is a global Astro type — no import needed.
interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

{
  images.length > 0 && (
    <ul class="gallery">
      {images.map((img) => (
        <li>
          <figure>
            <Image src={img.src} alt={img.alt} widths={[400, 800, 1200]} sizes="(min-width: 700px) 50vw, 100vw" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  )
}

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  figure img {
    border-radius: var(--radius-md);
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
</style>
